includes:
    - phpstan-baseline.neon

parameters:
    level: 3
    phpVersion: 80300
    paths: [.]
    excludePaths:
        - vendor/*
        - runtime/*
        - docs/*
        - graphify-out/*
        - .worktrees/*
        - backups/*
        - node_modules/*
        - .git/*
        - .github/*
        - .vscode/*
        - .claude/*
        - assets/*
        - contracts/*
        - data/*
        - docker/*
