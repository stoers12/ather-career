# Copy this file to .env and replace placeholder credentials.
MYSQL_DATABASE=portfolio_db
MYSQL_USER=portfolio_user
MYSQL_PASSWORD=replace_with_local_database_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password

DB_HOST=db
DB_PORT=3306
DB_NAME=${MYSQL_DATABASE}
DB_USER=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}

# Server-controlled absolute origin for shareable public Portfolio URLs.
# Configure the Owner HTTPS runtime explicitly; do not derive this from request headers.
PUBLIC_BASE_URL=https://localhost:8443

# Stable Evidence Hub target-reference key: exactly 64 hexadecimal characters
# (32 decoded bytes). Leave empty here; configure it only in the deployment
# secret store. Evidence Hub fails closed when it is missing or invalid.
EVIDENCE_HUB_OPAQUE_TARGET_HMAC_KEY=

# Use false for local HTTP and true when production is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Private onboarding draft HTTP boundary. Only exact 1 enables it; leave off.
# Independent of registration, policies, readiness and completion.
ATHERCAR_ONBOARDING_DRAFT_HTTP_ENABLED=0

# Exact-policy presentation/recording only. No approved documents; leave off.
ATHERCAR_ONBOARDING_ATTESTATION_HTTP_ENABLED=0

# Independent completion receipt/review/confirmation transport. Leave off.
ATHERCAR_ONBOARDING_COMPLETION_HTTP_ENABLED=0

# Auth0 Regular Web Application. Use an exact HTTPS issuer and callback URI.
EXPECTED_OIDC_ISSUER=https://your-tenant.us.auth0.com/
# Exact durable `sub` for the preserved V1 Owner. Required only for a fresh
# V1 baseline before the ownership contract migration has completed.
PRESERVED_V1_OIDC_SUBJECT=
OIDC_CLIENT_ID=replace_with_auth0_client_id
OIDC_CLIENT_SECRET=replace_with_auth0_client_secret
OIDC_REDIRECT_URI=https://your-domain.example/owner_oidc_callback.php

# Account purge (L-03): a separate Auth0 Machine-to-Machine application that is
# granted only the Management API scope delete:users. The domain is the
# tenant's canonical one (your-tenant.us.auth0.com), not a custom sign-in
# domain. Without these, scripts/ops/purge-deleted-accounts.php refuses to
# delete anything.
OIDC_MANAGEMENT_DOMAIN=
OIDC_MANAGEMENT_CLIENT_ID=
OIDC_MANAGEMENT_CLIENT_SECRET=

# Absolute server-controlled path outside the Apache document root.
ATHERCAR_STORAGE_ROOT=/var/lib/ather-career/storage
