# Copy this file to .env and replace placeholder credentials.
MYSQL_DATABASE=portfolio_db
MYSQL_USER=portfolio_user
MYSQL_PASSWORD=replace_with_local_database_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password

DB_HOST=db
DB_PORT=3306
DB_NAME=${MYSQL_DATABASE}
DB_USER=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}

# Use false for local HTTP and true when production is served over HTTPS.
SESSION_COOKIE_SECURE=false

ADMIN_USERNAME=replace_with_admin_username
# Generate with: php -r "echo password_hash('your-password', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASSWORD_HASH=replace_with_password_hash
# Keep true until the approved production authentication cutover. Setting false
# retires V1 /login.php and all V1 admin routes with a fail-closed 404.
LEGACY_ADMIN_AUTH_ENABLED=true

# Auth0 Regular Web Application. Use an exact HTTPS issuer and callback URI.
EXPECTED_OIDC_ISSUER=https://your-tenant.us.auth0.com/
OIDC_CLIENT_ID=replace_with_auth0_client_id
OIDC_CLIENT_SECRET=replace_with_auth0_client_secret
OIDC_REDIRECT_URI=https://your-domain.example/owner_oidc_callback.php

# Absolute server-controlled path outside the Apache document root.
ATHERCAR_STORAGE_ROOT=/var/lib/ather-career/storage
