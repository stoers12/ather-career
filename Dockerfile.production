FROM php:8.3-apache

RUN docker-php-ext-install pdo pdo_mysql

COPY docker/php/production.ini /usr/local/etc/php/conf.d/portfolio-production.ini
COPY docker/apache/access-policy.conf /etc/apache2/conf-enabled/zzz-portfolio-access-policy.conf
COPY docker/apache/production-vhost.conf /etc/apache2/sites-available/000-default.conf

WORKDIR /var/www/app

COPY . /var/www/app/

RUN mkdir -p /var/www/public/api /var/www/app/uploads/profile /var/www/app/uploads/projects \
    && cp -a /var/www/app/public/. /var/www/public/ \
    && cp /var/www/app/style.css /var/www/app/admin.css /var/www/app/script.js /var/www/app/admin.js /var/www/public/ \
    && cp /var/www/app/ChatGPT-Image-Apr-14-2025-065043-PM.png /var/www/public/ \
    && chown -R www-data:www-data /var/www/app/uploads
